// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import {Test, console} from "forge-std/Test.sol";
import {GovToken} from "../src/GovToken.sol";
import {MyGovernor} from "../src/MyGovernor.sol";
import {Box} from "../src/Box.sol";
import {TimelockController} from "@openzeppelin/contracts/governance/TimelockController.sol";
import {IGovernor} from "@openzeppelin/contracts/governance/IGovernor.sol";

contract GovernanceTest is Test {
    GovToken token;
    MyGovernor governor;
    TimelockController timelock;
    Box box;

    address deployer = makeAddr("deployer");
    address voter    = makeAddr("voter");
    address attacker = makeAddr("attacker");

    uint256 constant SUPPLY = 1_000_000e18;
    uint256 constant MIN_DELAY = 2 days;

    uint256 constant VOTING_DELAY  = 1;
    uint256 constant VOTING_PERIOD = 50400;

    function setUp() public {
        vm.startPrank(deployer);

        token = new GovToken(SUPPLY);

        address[] memory proposers = new address[](0);
        address[] memory executors = new address[](0);
        timelock = new TimelockController(MIN_DELAY, proposers, executors, deployer);

        governor = new MyGovernor(token, timelock);

        bytes32 proposerRole = timelock.PROPOSER_ROLE();
        bytes32 executorRole = timelock.EXECUTOR_ROLE();
        bytes32 adminRole    = timelock.DEFAULT_ADMIN_ROLE();

        timelock.grantRole(proposerRole, address(governor));
        timelock.grantRole(executorRole, address(0));
        timelock.revokeRole(adminRole, deployer);

        box = new Box();
        box.transferOwnership(address(timelock));

        token.transfer(voter, 600_000e18);
        vm.stopPrank();

        vm.prank(voter);
        token.delegate(voter);

        vm.prank(deployer);
        token.delegate(deployer);

        vm.roll(block.number + 1);
    }function test_LegitimateProposalExecutes() public {
        (
            address[] memory targets,
            uint256[] memory values,
            bytes[] memory calldatas,
            string memory description
        ) = _proposal(42, "Laillinen: tallenna 42");

        vm.prank(voter);
        uint256 id = governor.propose(targets, values, calldatas, description);

        vm.roll(block.number + VOTING_DELAY + 1);

        vm.prank(voter);
        governor.castVote(id, 1);

        vm.roll(block.number + VOTING_PERIOD + 1);

        bytes32 descHash = keccak256(bytes(description));

        governor.queue(targets, values, calldatas, descHash);

        vm.expectRevert();
        governor.execute(targets, values, calldatas, descHash);

        vm.warp(block.timestamp + MIN_DELAY + 1);

        governor.execute(targets, values, calldatas, descHash);

        assertEq(box.retrieve(), 42);
    }

    function test_FlashLoanVoteRevertsSameBlock() public {
        (
            address[] memory targets,
            uint256[] memory values,
            bytes[] memory calldatas,
            string memory description
        ) = _proposal(666, "Pahantahtoinen: tallenna 666");

        vm.prank(attacker);
        uint256 id = governor.propose(targets, values, calldatas, description);

        vm.prank(attacker);
        vm.expectRevert();
        governor.castVote(id, 1);
    }

    function test_BelowQuorumProposalDefeated() public {
        vm.prank(deployer);
        token.transfer(attacker, 30_000e18);

        vm.prank(attacker);
        token.delegate(attacker);
        vm.roll(block.number + 1);

        (
            address[] memory targets,
            uint256[] memory values,
            bytes[] memory calldatas,
            string memory description
        ) = _proposal(666, "Pahantahtoinen alle kvorumin");

        vm.prank(attacker);
        uint256 id = governor.propose(targets, values, calldatas, description);

        vm.roll(block.number + VOTING_DELAY + 1);

        vm.prank(attacker);
        governor.castVote(id, 1);

        vm.roll(block.number + VOTING_PERIOD + 1);

        IGovernor.ProposalState st = governor.state(id);
        console.log("Ehdotuksen tila (3 = Defeated):", uint256(st));
        assertTrue(st == IGovernor.ProposalState.Defeated, "pitaa havita kvorumin puutteeseen");

        bytes32 descHash = keccak256(bytes(description));
        vm.expectRevert();
        governor.queue(targets, values, calldatas, descHash);
    }

    function _proposal(uint256 value, string memory description)
        internal
        view
        returns (
            address[] memory targets,
            uint256[] memory values,
            bytes[] memory calldatas,
            string memory desc
        )
    {
        targets = new address[](1);
        values = new uint256[](1);
        calldatas = new bytes[](1);
        targets[0] = address(box);
        values[0] = 0;
        calldatas[0] = abi.encodeWithSignature("store(uint256)", value);
        desc = description;
    }
}
